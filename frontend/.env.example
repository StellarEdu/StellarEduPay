# Backend API base URL. Default "/api" = same-origin via the Next rewrite
# (BACKEND_PROXY_TARGET, default http://localhost:5000). Only set an absolute
# URL for a cross-host deployment — see docs/architecture.md.
NEXT_PUBLIC_API_URL=/api

# Stellar Network: "testnet" or "mainnet"
NEXT_PUBLIC_STELLAR_NETWORK=testnet
