# react-window@1.8.10 declares a peer dependency on react@^16.0.0 || ^17.0.0 || ^18.0.0.
# Until react-window ships official React 19 support (or is replaced), we need
# --legacy-peer-deps so that npm install / npm ci resolve correctly with React 19.
# Tracked in: https://github.com/bvaughn/react-window/issues/780
legacy-peer-deps=true
