# Optional: frontend API base URL. Defaults to "/api" (same-origin) when unset.
# This single value drives every client call (axios, /auth/me, SSE, CSV
# downloads) — see src/config/apiBase.js.
#
# Two supported values:
#   /api                    -> same-origin: the browser calls this app's own
#                              origin and next.config.js rewrites() proxies /api/*
#                              to the backend. Recommended — auth cookies stay
#                              first-party, and it works in split-host setups
#                              (e.g. GitHub Codespaces) without exposing the
#                              backend port. Override the proxy target with
#                              BACKEND_PROXY_TARGET (default http://localhost:5000).
#   http://localhost:5000/api -> direct/cross-host override: the browser calls
#                              the backend origin directly (requires CORS, the
#                              backend reachable from the browser and, across
#                              hosts, SameSite=None; Secure cookies).
NEXT_PUBLIC_API_URL=/api

# Stellar Network: "testnet" or "mainnet"
NEXT_PUBLIC_STELLAR_NETWORK=testnet
