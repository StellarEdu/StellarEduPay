{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/server.js",
    "src/app.js",
    "scripts/**/*.js",
    "migrations/**/*.js"
  ],
  "project": [
    "src/**/*.js",
    "scripts/**/*.js",
    "migrations/**/*.js"
  ],
  "ignore": [
    "src/**/__tests__/**",
    "src/**/*.test.js"
  ],
  "ignoreDependencies": [
    "nodemon",
    "depcheck"
  ]
}
