{
  "name": "stellaredupay",
  "version": "1.0.0",
  "scripts": {
    "check:syntax": "node ./scripts/check-syntax.js",
    "test": "jest --testPathPattern=tests/ --forceExit",
    "coverage": "jest --testPathPattern=tests/ --forceExit --coverage",
    "coverage:frontend": "cd frontend && npm run coverage",
    "test:e2e": "jest tests/e2e/ --forceExit --runInBand --testPathIgnorePatterns=/node_modules/",
    "test:integration": "cross-env RUN_INTEGRATION_TESTS=true jest tests/stellar.integration.test.js --forceExit",
    "test:loadsim": "jest --testPathPattern=tests/loadsim/ --testPathIgnorePatterns=/node_modules/ --forceExit",
    "test:docker-healthcheck": "cross-env RUN_DOCKER_COMPOSE_HEALTHCHECK_TESTS=true jest tests/dockerComposeHealthCheck.test.js --forceExit",
    "seed": "node scripts/seed-test-data.js",
    "check-version-drift": "node scripts/check-version-drift.js"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "babel-jest": "^29.7.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "js-yaml": "^4.1.0",
    "mongodb-memory-server": "^9.1.1",
    "mongoose": "^8.0.0",
    "prom-client": "^15.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "speakeasy": "^2.0.0",
    "supertest": "^6.3.0"
  },
  "jest": {
    "moduleDirectories": [
      "node_modules",
      "backend/node_modules",
      "frontend/node_modules"
    ],
    "moduleNameMapper": {
      "^ioredis$": "<rootDir>/node_modules/ioredis",
      "^bullmq$": "<rootDir>/node_modules/bullmq",
      "^react$": "<rootDir>/node_modules/react",
      "^react-dom$": "<rootDir>/node_modules/react-dom",
      "^react/(.*)$": "<rootDir>/node_modules/react/$1",
      "^react-dom/(.*)$": "<rootDir>/node_modules/react-dom/$1",
      "^axios$": "<rootDir>/tests/__stubs__/axios.js",
      "^next/router$": "<rootDir>/tests/__stubs__/next-router.js",
      "^next/link$": "<rootDir>/tests/__stubs__/next-link.js"
    },
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(@stellar/stellar-sdk)/)"
    ],
    "setupFilesAfterEnv": [
      "./tests/setup/blockRealHttp.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/backend/",
      "tests/stellar\\.integration\\.test\\.js",
      "tests/integration/",
      "tests/e2e/",
      "tests/loadsim/"
    ],
    "collectCoverageFrom": [
      "backend/src/**/*.js",
      "!backend/src/**/*.test.js",
      "!backend/src/**/__tests__/**"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov",
      "json-summary",
      "html",
      "cobertura"
    ],
    "coverageDirectory": "coverage/backend",
    "coverageThreshold": {
      "global": {
        "branches": 46,
        "functions": 37,
        "lines": 51,
        "statements": 51
      },
      "./backend/src/services/": {
        "branches": 45,
        "functions": 51,
        "lines": 53,
        "statements": 52
      },
      "./backend/src/middleware/": {
        "branches": 45,
        "functions": 42,
        "lines": 52,
        "statements": 50
      },
      "./backend/src/controllers/": {
        "branches": 32,
        "functions": 32,
        "lines": 37,
        "statements": 36
      }
    }
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "bullmq": "^5.71.1",
    "decimal.js": "^10.6.0",
    "ioredis": "^5.10.1",
    "node-cache": "^5.1.2"
  }
}
